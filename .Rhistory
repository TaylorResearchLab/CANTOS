Plt_5th_ed_LTE3 <- ggplot(distances_5th_edition,
aes(x = standardization_result_LTE3,
y = Euclidean_distance_LTE_embedding,
color = standardization_result_LTE3)) +
geom_boxplot() +
scale_color_brewer(palette = "Dark2") +  # changed to scale_color_brewer to match 'color=' aesthetic
labs(
y = "Euclidean distance in LTE-3 embedding space",
x = "Standardization results for WHO 5th edition, n = 1044",
title = "a"
) +
theme(
plot.title = element_text(size = 18, face = "bold", hjust = 0.5),   # center and enlarge title
axis.title.x = element_text(size = 16),
axis.title.y = element_text(size = 16),
axis.text.x = element_text(size = 14),
axis.text.y = element_text(size = 14),
legend.title = element_text(size = 16),
legend.text = element_text(size = 14)
)
Plt_all_ed_LTE3 <- ggplot(distances_all_edition,
aes(x = standardization_result_LTE3,
y = Euclidean_distance_LTE_embedding,
color = standardization_result_LTE3)) +
geom_boxplot() +
scale_color_brewer(palette = "Dark2") +  # changed to scale_color_brewer to match 'color=' aesthetic
labs(
y = "Euclidean distance in LTE-3 embedding space",
x = "Standardization results for WHO all edition, n = 1118",
title = "a"
) +
theme(
plot.title = element_text(size = 18, face = "bold", hjust = 0.5),   # center and enlarge title
axis.title.x = element_text(size = 16),
axis.title.y = element_text(size = 16),
axis.text.x = element_text(size = 14),
axis.text.y = element_text(size = 14),
legend.title = element_text(size = 16),
legend.text = element_text(size = 14)
)
Plt_LTE<-ggarrange(Plt_5th_ed_LTE3, Plt_all_ed_LTE3,nrow = 1,ncol = 2)
Plt_LTE
